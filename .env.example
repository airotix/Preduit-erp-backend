# Local environment
ENV=dev
APP_BASE_URL=http://localhost:3000

# PostgreSQL running in Docker, backend running on Windows
DB_HOST=localhost
DB_PORT=5432
DB_NAME=preduit
DB_APP_USER=erp_app
DB_APP_PASSWORD=changeme
DB_SYSTEM_USER=erp_system
DB_SYSTEM_PASSWORD=changeme
DB_SSLMODE=prefer

# Local authentication
DEV_AUTH_BYPASS=false
DEV_TENANT_ID=
DEV_EXTERNAL_ID=dev-user
DEV_EMAIL=dev@preduit.local

# JWT — local development only
JWT_SECRET=dev-insecure-change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Refresh cookie
REFRESH_COOKIE_NAME=erp_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax

# Authentication protection
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=10

# Frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Entra — unused by the current local JWT login
ENTRA_TENANT_ID=
ENTRA_AUTHORITY=
ENTRA_API_AUDIENCE=
ENTRA_OPENID_CONFIG=

# Forecasting engine — disabled until configured
AI_ENGINE_ENABLED=false
AI_ENGINE_URL=http://ai-engine.invalid/api
AI_ENGINE_TOKEN=

# Exchange rates — insert your existing key to enable
FX_PROVIDER_URL=https://v6.exchangerate-api.com/v6
FX_API_KEY=a3ef15ef9cbeb3b661e1e349

# Email — blank values use the local development fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mustafazaki616@gmail.com
SMTP_PASSWORD=jwjf kmge ateq wyaw
SMTP_USE_TLS=true
MAIL_FROM=mustafazaki616@gmail.com
MAIL_FROM_NAME=Preduit Retail

# Local document storage
DOC_STORAGE_DIR=./storage

# S3 — blank bucket keeps local storage enabled
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Redis connection — requires Redis if a feature uses it
REDIS_URL=redis://localhost:6379/0

# Upload limit: 15 MB
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_EXTS=png,jpg,jpeg,gif,webp,svg,pdf,csv,txt,doc,docx,xls,xlsx,ppt,pptx
UPLOAD_ALLOWED_MIMES=image/png,image/jpeg,image/gif,image/webp,image/svg+xml,application/pdf,text/csv,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/octet-stream:wq
