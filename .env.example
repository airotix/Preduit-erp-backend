# Copy to .env for local dev. In Azure these come from Key Vault / Container App env.
ENV=dev

# --- Database (two principals, plan §2) ---
# SQL_SERVER may be "localhost", "localhost\SQLEXPRESS", or an Azure FQDN.
SQL_SERVER=DESKTOP-9QDR256
SQL_DATABASE=Preduit-ERP
# Runtime app user: subject to Row-Level Security.
SQL_APP_USER=erp_app
SQL_APP_PASSWORD=changeme
# Provisioning/admin principal: EXEMPT from RLS (creates tenants, seeds defaults).
SQL_SYSTEM_USER=erp_system
SQL_SYSTEM_PASSWORD=changeme
# Local SQL Server: trust its self-signed cert. On Azure use encrypt=yes, trust=no.
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERT=yes

# --- Dev login bypass (local only; NEVER true in production) ---
DEV_AUTH_BYPASS=false
DEV_TENANT_ID=
DEV_EMAIL=dev@preduit.local

# --- Microsoft Entra External ID (CIAM) — required when DEV_AUTH_BYPASS=false ---
ENTRA_API_AUDIENCE=api://preduit-erp
ENTRA_OPENID_CONFIG=https://<your-ciam-tenant>.ciamlogin.com/<tenant>/v2.0/.well-known/openid-configuration

# --- AI Insights: external Forcaster forecasting engine ---
# The backend converses with this engine and materialises its responses into the
# ai_snapshot tables. The browser only ever calls the ERP /api/v1/ai facade.
# Keep DISABLED until the engine is live — the AI tabs then run with empty data
# (no calls, no timeouts, no crashes). Flip to true and set the URL when ready.
AI_ENGINE_ENABLED=false
AI_ENGINE_URL=http://ai-engine.invalid/api
# AI_ENGINE_TOKEN=   # optional bearer token for the engine

# --- FX rates provider: ExchangeRate-API (exchangerate-api.com) ---
# Keeps the dated exchange_rates table current for currency conversion. Supports
# any base currency (incl. PKR) and ~160 currencies.
# Get a FREE key: sign up at https://www.exchangerate-api.com/ → copy your API key.
# The backend calls {FX_PROVIDER_URL}/{FX_API_KEY}/latest/{BASE_CURRENCY}.
FX_PROVIDER_URL=https://v6.exchangerate-api.com/v6
FX_API_KEY=a3ef15ef9cbeb3b661e1e349

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
